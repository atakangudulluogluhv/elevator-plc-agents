<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL" Id="{3797568a-cf39-4b5e-860a-00d023f684e8}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
//Input to PLC from process
	ixButtonAtLevel1		AT %I*:	BOOL;		(* Button at level 1 *)
	ixButtonAtLevel2		AT %I*:	BOOL;		(* Button at level 2 *)
	ixButtonAtLevel3		AT %I*:	BOOL;		(* Button at level 3 *)

	ixSensorAtLevel1 		AT %I*: BOOL;		(* Sensor at level 1 for elevator presence *)
	ixSensorAtLevel2 		AT %I*: BOOL;		(* Sensor at level 2 for elevator presence *)
	ixSensorAtLevel3 		AT %I*: BOOL;		(* Sensor at level 3 for elevator presence *)

	ixButtGreen 			AT %I*:	BOOL;		(* Green button *)
	ixButtRed				AT %I*:	BOOL;		(* Red button, normally closed *)

	ixButtInsideElevat1		AT %I*:	BOOL;		(* Button 1 inside elevator PLCSim only *)
	ixButtInsideElevat2		AT %I*:	BOOL;		(* Button 2 inside elevator PLCSim only *)
	ixButtInsideElevat3		AT %I*:	BOOL;		(* Button 3 inside elevator PLCSim only *)
	
	ixDoorClosed			AT %I*: BOOL;		(* Sensor for door closed PLCSim only *)
	ixDoorOpen				AT %I*:	BOOL;		(* Sensor for door open   PLCSim only *)

//Output from PLC to process
	qxLampAtLevel1		AT %Q*:	BOOL;		(* Lamp at level 1*)
	qxLampAtLevel2		AT %Q*:	BOOL;		(* Lamp at level 2*)
	qxLampAtLevel3		AT %Q*:	BOOL;		(* Lamp at level 3*)
	
	qxMotorDown			AT %Q*:	BOOL;		(* Run motor down *)
	qxMotorUp			AT %Q*:	BOOL;		(* Run motor up *)

	qxLampElevat1 		AT %Q*:	BOOL;		(* Lamp 1 inside elevator PLCSim only*)
	qxLampElevat2 		AT %Q*:	BOOL;		(* Lamp 2 inside elevator PLCSim only *)
	qxLampElevat3 		AT %Q*:	BOOL;		(* Lamp 3 inside elevator PLCSim only *)

	qxDoorClose			AT %Q*:	BOOL;		(* Close door and keep it closed  PLCSim only *)
	qiDispElevat 		AT %Q*:	UINT;		(* Integer display inside elevator PLCSim only *)
	qxButtonAtLevel1: BOOL;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>